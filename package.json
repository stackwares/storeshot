{
  "name": "storeshot",
  "version": "0.1.0",
  "description": "StoreShot — design App Store and Google Play marketing screenshots on a connected canvas.",
  "license": "MIT",
  "author": "Stackwares",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackwares/storeshot-electron.git"
  },
  "bugs": {
    "url": "https://github.com/stackwares/storeshot-electron/issues"
  },
  "homepage": "https://github.com/stackwares/storeshot-electron#readme",
  "keywords": [
    "app-store",
    "screenshots",
    "aso",
    "electron",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "mcp": "bun src/mcp/server.ts",
    "mcp:call": "bun src/mcp/client.ts",
    "electron:dev": "electron ./electron/main.js",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "dist:mas": "npm run build && electron-builder --mac mas"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.11",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "next": "^15.5.25",
    "react": "^19",
    "react-dom": "^19",
    "react-rnd": "^10.5.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.storeshot.app",
    "productName": "StoreShot",
    "files": [
      "electron/**/*",
      ".next/standalone/**/*",
      "package.json"
    ],
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "mas": {
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.plist",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
